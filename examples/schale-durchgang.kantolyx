{
  "format": "kantolyx-project",
  "formatVersion": 1,
  "appVersion": "0.5.65",
  "name": "schale-durchgang",
  "steps": [
    {
      "id": "sbase",
      "type": "cube",
      "enabled": true,
      "params": {
        "width": 2,
        "height": 2,
        "depth": 2
      }
    },
    {
      "id": "sshell",
      "type": "shell",
      "enabled": true,
      "params": {
        "thickness": 0.1,
        "openings": [
          "sbase/top",
          "sbase/bottom"
        ]
      }
    }
  ]
}
